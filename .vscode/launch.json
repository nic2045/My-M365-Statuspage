{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Docker App",
      "type": "python",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMapping": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/app"
        }
      ],
      "justMyCode": true
    },
    {
      "name": "Docker: View Logs",
      "type": "shell",
      "request": "launch",
      "command": "make",
      "args": ["logs"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    }
  ]
}
