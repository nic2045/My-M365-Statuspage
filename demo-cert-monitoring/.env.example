# ── Demo-Ziele ────────────────────────────────────────────────────────────
# 2-3 URLs, kommagetrennt, ohne Leerzeichen um die Kommas.
# Jede URL wird per HTTP(S)-Check (Erreichbarkeit) UND TLS-Zertifikatsprüfung
# (Ablaufdatum) durch den blackbox_exporter überwacht.
DEMO_TARGET_URLS=https://www.google.com,https://www.github.com,https://www.wikipedia.org

# ── Grafana (App-Owner-Dashboard) ───────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please
GRAFANA_PORT=3000

# ── Prometheus / blackbox_exporter ──────────────────────────────────────────
PROMETHEUS_PORT=9090
BLACKBOX_EXPORTER_PORT=9115

# ── OneUptime-Anbindung (öffentliche Statuspage für Endnutzer) ─────────────
# Optional. Ohne diese Werte läuft der Prometheus/Grafana-Teil trotzdem
# vollständig - nur der Sync zu OneUptime wird übersprungen.
#
# In OneUptime pro Ziel-URL einen Monitor vom Typ "Incoming Request" /
# "Heartbeat" anlegen. OneUptime generiert dafür eine eindeutige URL, die
# hier eingetragen wird - Reihenfolge muss zu DEMO_TARGET_URLS passen.
# ONEUPTIME_HEARTBEAT_URLS=https://oneuptime.example.com/heartbeat/xxx,https://oneuptime.example.com/heartbeat/yyy,https://oneuptime.example.com/heartbeat/zzz
ONEUPTIME_HEARTBEAT_URLS=

# Wie oft (Sekunden) der Sync-Loop Prometheus abfragt und ggf. OneUptime pingt
SYNC_INTERVAL_SECONDS=60

# ── Demo-Incident-Fixture (demo-broken-site) ────────────────────────────────
# Feste Website mit selbstsigniertem Zertifikat, die ihr live per
# ./break-demo.sh "kaputt" macht und per ./fix-demo.sh wieder repariert -
# siehe README.md, Abschnitt "Test-Incident". Läuft immer mit, startet
# standardmäßig gesund (siehe scripts/gen-demo-cert.sh).
DEMO_BROKEN_SITE_PORT=8443

# Optional: eigener OneUptime-Heartbeat-Monitor NUR für demo-broken-site,
# unabhängig von ONEUPTIME_HEARTBEAT_URLS oben. Legt einen weiteren
# "Incoming Request"-Monitor in OneUptime an und tragt dessen URL hier ein,
# um den kompletten Vorfall (break-demo.sh -> Prometheus-Alert -> Grafana ->
# oneuptime-sync -> OneUptime-Statuspage) live vorzuführen.
# ONEUPTIME_DEMO_HEARTBEAT_URL=https://oneuptime.example.com/heartbeat/demo
ONEUPTIME_DEMO_HEARTBEAT_URL=

# Ab wie vielen verbleibenden Tagen der Sync das Zertifikat von
# demo-broken-site als "kritisch" behandelt und aufhört zu pingen (auch
# wenn die Seite selbst noch erreichbar ist) - passend zum
# CertificateExpiringCritical-Schwellenwert in prometheus/alert_rules.yml.
DEMO_CERT_CRITICAL_DAYS=3
