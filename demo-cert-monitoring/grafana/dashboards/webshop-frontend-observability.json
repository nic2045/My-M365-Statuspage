{
  "title": "shop.pyur.com – Frontend Observability",
  "uid": "webshop-frontend-observability",
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Core Web Vitals & Fehler",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Verfügbarkeit",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "shop_availability_ratio * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.5
              }
            ]
          },
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "LCP (Largest Contentful Paint)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "shop_lcp_seconds",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2.5
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          },
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "INP (Interaction to Next Paint)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "shop_inp_milliseconds",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 200
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          },
          "unit": "ms",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "CLS (Cumulative Layout Shift)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "shop_cls_score",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Seitenladezeit je Seitentyp",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "shop_page_load_seconds{page=\"Startseite\"}",
          "legendFormat": "Startseite",
          "refId": "A"
        },
        {
          "expr": "shop_page_load_seconds{page=\"Kategorie\"}",
          "legendFormat": "Kategorie",
          "refId": "B"
        },
        {
          "expr": "shop_page_load_seconds{page=\"Produkt\"}",
          "legendFormat": "Produkt",
          "refId": "C"
        },
        {
          "expr": "shop_page_load_seconds{page=\"Warenkorb\"}",
          "legendFormat": "Warenkorb",
          "refId": "D"
        },
        {
          "expr": "shop_page_load_seconds{page=\"Checkout\"}",
          "legendFormat": "Checkout",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "smooth"
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "JS-Fehlerrate & Suche-Trefferquote",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "shop_js_error_rate_percent",
          "legendFormat": "JS-Fehlerrate (%)",
          "refId": "A"
        },
        {
          "expr": "shop_search_success_rate_percent",
          "legendFormat": "Suche-Trefferquote (%)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "smooth"
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Vertragsabschluss-Funnel (Internet)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false
    },
    {
      "id": 9,
      "type": "text",
      "title": "Über diesen Funnel",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "options": {
        "mode": "markdown",
        "content": "Jeder Schritt des Internet-Vertragsabschlusses auf shop.pyur.com, von der Tarifauswahl bis zur Bestätigung. Zeigt **an welchem Schritt** Besucher abbrechen (Balkenhöhe = verbleibende Nutzer) und **wie lange** sie auf jedem Schritt bleiben."
      }
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Nutzer je Schritt (Funnel)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "shop_funnel_step_entries_total",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "label": "Schritt",
              "shop_funnel_step_entries_total": "Nutzer"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xTickLabelRotation": 0,
        "showValue": "always",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Ø Verweildauer je Schritt",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "shop_funnel_step_avg_duration_seconds{step=\"tarifauswahl\"}",
          "legendFormat": "Tarifauswahl",
          "refId": "A"
        },
        {
          "expr": "shop_funnel_step_avg_duration_seconds{step=\"verfuegbarkeit\"}",
          "legendFormat": "Verfügbarkeitsprüfung",
          "refId": "B"
        },
        {
          "expr": "shop_funnel_step_avg_duration_seconds{step=\"persoenliche_daten\"}",
          "legendFormat": "Persönliche Daten",
          "refId": "C"
        },
        {
          "expr": "shop_funnel_step_avg_duration_seconds{step=\"vertragsuebersicht\"}",
          "legendFormat": "Vertragsübersicht",
          "refId": "D"
        },
        {
          "expr": "shop_funnel_step_avg_duration_seconds{step=\"bestaetigung\"}",
          "legendFormat": "Bestätigung",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "smooth"
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Gesamt-Abschlussquote (Bestätigung / Tarifauswahl)",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "shop_funnel_step_entries_total{step=\"bestaetigung\"} / shop_funnel_step_entries_total{step=\"tarifauswahl\"} * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      }
    }
  ]
}
