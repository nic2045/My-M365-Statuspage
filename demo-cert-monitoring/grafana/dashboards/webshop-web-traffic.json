{
  "title": "shop.pyur.com – Web-Traffic & Fehlercodes",
  "uid": "webshop-web-traffic",
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Hinweis",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Prometheus-natives Äquivalent zu einem Loki+NGINX-Log-Dashboard - Request-Rate und HTTP-Statuscodes aus Metriken statt aus echten Logzeilen. Für echte Logzeilen siehe **Telemetry -> Logs** in OneUptime (DocuWare-Login-Story, siehe README)."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Web-Traffic & Fehlercodes",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "collapsed": false
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Request-Rate",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "shop_request_rate_per_second",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "5xx-Rate",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(shop_http_requests_total{status_class=\"5xx\"}[5m]) / sum(rate(shop_http_requests_total[5m])) * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "4xx-Rate",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(shop_http_requests_total{status_class=\"4xx\"}[5m]) / sum(rate(shop_http_requests_total[5m])) * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          },
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests nach Statuscode-Klasse (Rate/Min)",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(shop_http_requests_total{status_class=\"2xx\"}[5m]) * 60",
          "legendFormat": "2xx",
          "refId": "A"
        },
        {
          "expr": "rate(shop_http_requests_total{status_class=\"3xx\"}[5m]) * 60",
          "legendFormat": "3xx",
          "refId": "B"
        },
        {
          "expr": "rate(shop_http_requests_total{status_class=\"4xx\"}[5m]) * 60",
          "legendFormat": "4xx",
          "refId": "C"
        },
        {
          "expr": "rate(shop_http_requests_total{status_class=\"5xx\"}[5m]) * 60",
          "legendFormat": "5xx",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "smooth"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Fehlerrate je Pfad",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "shop_http_path_error_rate_percent",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "path": "Pfad",
              "shop_http_path_error_rate_percent": "Fehlerrate (%)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xTickLabelRotation": 0,
        "showValue": "always",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ]
}
