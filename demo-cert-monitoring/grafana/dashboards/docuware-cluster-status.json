   },
   "targets": [
    {
     "expr": "docuware_vmware_host_cpu_percent",
     "legendFormat": "CPU %",
     "refId": "A"
    },
    {
     "expr": "docuware_vmware_host_memory_percent",
     "legendFormat": "RAM %",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineInterpolation": "smooth"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "IIS/Web-Tier – Antwortzeit & aktive Anfragen",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 42
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "docuware_iis_response_time_ms",
     "legendFormat": "Antwortzeit (ms)",
     "refId": "A"
    },
    {
     "expr": "docuware_iis_active_requests",
     "legendFormat": "Aktive Anfragen",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineInterpolation": "smooth"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "WAF – Anfragen gesamt vs. blockiert (Rate/Min)",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 42
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "rate(docuware_waf_requests_total[5m]) * 60",
     "legendFormat": "Anfragen gesamt",
     "refId": "A"
    },
    {
     "expr": "rate(docuware_waf_blocked_total[5m]) * 60",
     "legendFormat": "Blockiert",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineInterpolation": "smooth"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 17,
   "type": "table",
   "title": "Hardware-Status (SAN / Strom / Kühlung)",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 49
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "docuware_hardware_status",
     "instant": true,
     "format": "table",
     "refId": "A"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true
      },
      "renameByName": {
       "component": "Komponente"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "A"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Status"
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "green",
           "value": 1
          }
         ]
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 18,
   "type": "timeseries",
   "title": "Speicherplatz-Auslastung (SAN-Volumes)",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 49
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "docuware_disk_usage_percent{volume=\"Dokumentenspeicher\"}",
     "legendFormat": "Dokumentenspeicher",
     "refId": "A"
    },
    {
     "expr": "docuware_disk_usage_percent{volume=\"Datenbank\"}",
     "legendFormat": "Datenbank",
     "refId": "B"
    },
    {
     "expr": "docuware_disk_usage_percent{volume=\"Log\"}",
     "legendFormat": "Log",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "max": 100,
     "min": 0,
     "custom": {
      "lineInterpolation": "smooth"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   }
  }
 ]
}
