{
 "title": "DocuWare – Cluster-Status (App-Owner)",
 "uid": "docuware-cluster-status",
 "timezone": "browser",
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "DocuWare – Gesamtstatus (1 = gesund)",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "min(docuware_mssql_cluster_node_up) * on() min(docuware_hardware_status) * on() probe_success{job=\"docuware_site\"}",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Website erreichbar (docuware.pyur.com)",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "probe_success{job=\"docuware_site\"}",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Aktive Website-Verbindungen",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "docuware_website_active_connections",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "WAF – blockierte Anfragen (pro Minute)",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "rate(docuware_waf_blocked_total[5m]) * 60",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 5
       },
       {
        "color": "red",
        "value": 20
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Kundenportal – Rechnungsabruf (aktive Sitzungen)",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "docuware_customer_portal_active_sessions",
     "legendFormat": "Aktive Sitzungen",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineInterpolation": "smooth"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Kundenportal – Anfragen & abgerufene Rechnungen (Rate/Min)",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "rate(docuware_customer_portal_requests_total[5m]) * 60",
     "legendFormat": "Anfragen",
     "refId": "A"
    },
    {
     "expr": "rate(docuware_customer_portal_invoices_retrieved_total[5m]) * 60",
     "legendFormat": "Rechnungen abgerufen",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineInterpolation": "smooth"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "DocuWare-Dienste – RAM-Nutzung vs. Alert-Limit",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "docuware_service_memory_used_mb{service=\"content-server\"}",
     "legendFormat": "Content Server – belegt",
     "refId": "A"
    },
    {
     "expr": "docuware_service_memory_limit_mb{service=\"content-server\"}",
     "legendFormat": "Content Server – Limit",
     "refId": "B"
    },
    {
     "expr": "docuware_service_memory_used_mb{service=\"platform-service\"}",
     "legendFormat": "Platform Service – belegt",
     "refId": "C"
    },
    {
     "expr": "docuware_service_memory_limit_mb{service=\"platform-service\"}",
     "legendFormat": "Platform Service – Limit",
     "refId": "D"
    },
    {
     "expr": "docuware_service_memory_used_mb{service=\"autoindex-service\"}",
     "legendFormat": "Autoindex Service – belegt",
     "refId": "E"
    },
    {
     "expr": "docuware_service_memory_limit_mb{service=\"autoindex-service\"}",
     "legendFormat": "Autoindex Service – Limit",
     "refId": "F"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "decmbytes",
     "custom": {
      "lineInterpolation": "smooth"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "DocuWare-Dienste – Abstand zum Alert-Limit (%)",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "100 * (1 - docuware_service_memory_used_mb{service=\"content-server\"} / docuware_service_memory_limit_mb{service=\"content-server\"})",
     "legendFormat": "Content Server",
     "refId": "A"
    },
    {
     "expr": "100 * (1 - docuware_service_memory_used_mb{service=\"platform-service\"} / docuware_service_memory_limit_mb{service=\"platform-service\"})",
     "legendFormat": "Platform Service",
     "refId": "B"
    },
    {
     "expr": "100 * (1 - docuware_service_memory_used_mb{service=\"autoindex-service\"} / docuware_service_memory_limit_mb{service=\"autoindex-service\"})",
     "legendFormat": "Autoindex Service",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineInterpolation": "smooth"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "App-Server (2x, Windows) – CPU/RAM",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 20
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "docuware_appserver_cpu_percent{server=\"app1\"}",
     "legendFormat": "app1 CPU",
     "refId": "A"
    },
    {
     "expr": "docuware_appserver_memory_percent{server=\"app1\"}",
     "legendFormat": "app1 RAM",
     "refId": "B"
    },
    {
     "expr": "docuware_appserver_cpu_percent{server=\"app2\"}",
     "legendFormat": "app2 CPU",
     "refId": "C"
    },
    {
     "expr": "docuware_appserver_memory_percent{server=\"app2\"}",
     "legendFormat": "app2 RAM",
     "refId": "D"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineInterpolation": "smooth"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "DB-Cluster (2x MSSQL) – CPU/RAM",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 20
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "docuware_dbserver_cpu_percent{server=\"db1\"}",
     "legendFormat": "db1 CPU",
     "refId": "A"
    },
    {
     "expr": "docuware_dbserver_memory_percent{server=\"db1\"}",
     "legendFormat": "db1 RAM",
     "refId": "B"
    },
    {
     "expr": "docuware_dbserver_cpu_percent{server=\"db2\"}",
     "legendFormat": "db2 CPU",
     "refId": "C"
    },
    {
     "expr": "docuware_dbserver_memory_percent{server=\"db2\"}",
     "legendFormat": "db2 RAM",
     "refId": "D"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineInterpolation": "smooth"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "DB-Cluster – Replikations-Lag & APM Query-Dauer",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 28
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "docuware_mssql_replication_lag_seconds",
     "legendFormat": "Replikations-Lag (s)",
     "refId": "A"
    },
    {
     "expr": "docuware_mssql_apm_query_duration_ms",
     "legendFormat": "APM Query-Dauer (ms)",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineInterpolation": "smooth"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 12,
   "type": "table",
   "title": "DB-Cluster – Knotenstatus",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 28
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "docuware_mssql_cluster_node_up",
     "instant": true,
     "format": "table",
     "refId": "A"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true
      },
      "renameByName": {
       "node": "Knoten"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "A"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Online"
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "green",
           "value": 1
          }
         ]
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "BIG-IP F5 Loadbalancer",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 35
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "docuware_loadbalancer_cpu_percent",
     "legendFormat": "CPU %",
     "refId": "A"
    },
    {
     "expr": "docuware_loadbalancer_throughput_mbps",
     "legendFormat": "Durchsatz (Mbit/s)",
     "refId": "B"
    },
    {
     "expr": "docuware_loadbalancer_active_connections",
     "legendFormat": "Aktive Verbindungen",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
