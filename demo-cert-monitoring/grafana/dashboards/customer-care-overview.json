     "expr": "(cc_site_vpn_up * 2) - (cc_site_vpn_up * (100 * cc_site_vpn_bandwidth_used_mbps / cc_site_vpn_bandwidth_capacity_mbps >= bool 85)) or cc_site_info{role=\"hub\"} * 2",
