    },
    {
     "expr": "(cc_site_vpn_up{site=\"Halle (Saale)\"} * 2) - (cc_site_vpn_up{site=\"Halle (Saale)\"} * (100 * cc_site_vpn_bandwidth_used_mbps{site=\"Halle (Saale)\"} / cc_site_vpn_bandwidth_capacity_mbps{site=\"Halle (Saale)\"} >= bool 85)) or cc_site_info{role=\"hub\"} * 2",
     "instant": true,
