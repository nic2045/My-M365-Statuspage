     "format": "table",
     "refId": "A"
    },
    {
     "expr": "(cc_site_vpn_up{site=\"Berlin\"} * 2) - (cc_site_vpn_up{site=\"Berlin\"} * (100 * cc_site_vpn_bandwidth_used_mbps{site=\"Berlin\"} / cc_site_vpn_bandwidth_capacity_mbps{site=\"Berlin\"} >= bool 85)) or cc_site_info{role=\"hub\"} * 2",
