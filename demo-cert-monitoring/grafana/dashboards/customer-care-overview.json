{
 "title": "Customer Care – Standortübersicht (Technical Owner)",
 "uid": "customer-care-overview",
 "timezone": "browser",
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Customer Care – Gesamtstatus (1 = gesund)",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "min(cc_site_vpn_up) * on() cc_avaya_sip_registration_status",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Standorte mit VPN-Störung",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "count(cc_site_vpn_up == 0) or vector(0)",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Anrufe in Warteschlange",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cc_avaya_calls_queued",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 15
       },
       {
        "color": "red",
        "value": 30
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Ø Wartezeit (Sekunden)",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cc_avaya_avg_wait_seconds",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 60
       },
       {
        "color": "red",
        "value": 120
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Warteschlange & Wartezeit",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cc_avaya_calls_queued",
     "legendFormat": "Anrufe in Warteschlange",
     "refId": "A"
    },
    {
     "expr": "cc_avaya_avg_wait_seconds",
     "legendFormat": "Ø Wartezeit (s)",
     "refId": "B"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "SIP-Trunk-Auslastung & abgebrochene Anrufe (Rate/Min)",
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cc_avaya_sip_trunk_utilization_percent",
     "legendFormat": "Trunk-Auslastung %",
     "refId": "A"
    },
    {
     "expr": "rate(cc_avaya_calls_abandoned_total[5m]) * 60",
     "legendFormat": "Abgebrochen/Min",
     "refId": "B"
    }
   ]
  },
  {
   "id": 7,
   "type": "table",
   "title": "Agenten je Standort (verfügbar / im Gespräch)",
   "gridPos": {
    "h": 7,
    "w": 24,
    "x": 0,
    "y": 13
