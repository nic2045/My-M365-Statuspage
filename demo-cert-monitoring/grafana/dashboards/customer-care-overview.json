  {
   "id": 7,
   "type": "barchart",
   "title": "Agenten je Standort (verfügbar / im Gespräch)",
   "gridPos": {
    "h": 7,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cc_avaya_agents_available",
     "instant": true,
     "format": "table",
     "refId": "A"
    },
    {
     "expr": "cc_avaya_agents_busy",
     "instant": true,
     "format": "table",
     "refId": "B"
    }
   ],
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {}
    },
    {
     "id": "merge",
     "options": {},
     "filter": {
      "id": "byFrameRefID",
      "options": "A"
     }
    },
    {
     "id": "merge",
     "options": {},
     "filter": {
      "id": "byFrameRefID",
      "options": "B"
     }
    },
    {
     "id": "joinByField",
     "options": {
      "byField": "site",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 2": true,
       "__name__": true,
       "__name__ 2": true,
       "instance": true,
       "instance 2": true,
       "job": true,
       "job 2": true
      },
      "renameByName": {
       "site": "Standort",
       "cc_avaya_agents_available": "Verfügbar",
       "cc_avaya_agents_busy": "Im Gespräch"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "axisLabel": "Agenten"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Verfügbar"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Im Gespräch"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "orientation": "vertical",
    "xTickLabelRotation": 0,
    "xTickLabelSpacing": 0,
    "showValue": "always",
    "stacking": "none",
    "groupWidth": 0.7,
    "barWidth": 0.85,
    "barRadius": 0,
    "fullHighlight": false,
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   }
  },
