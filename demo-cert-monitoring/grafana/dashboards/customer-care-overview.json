  {
   "id": 17,
   "type": "geomap",
   "title": "Deutschlandkarte – VPN-Status je Standort (Leipzig = RZ)",
   "gridPos": {
    "h": 14,
    "w": 14,
    "x": 0,
    "y": 55
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cc_site_vpn_up",
     "instant": true,
     "format": "table",
     "refId": "A"
    }
   ],
   "options": {
    "view": {
     "id": "fitData"
    },
    "controls": {
     "showZoom": true,
     "mouseWheelZoom": true,
     "showAttribution": true,
     "showScale": false,
     "showMeasure": false
    },
    "basemap": {
     "type": "osm-standard",
     "name": "Basiskarte",
     "config": {}
    },
    "layers": [
     {
      "type": "markers",
      "name": "Standorte",
      "config": {
       "style": {
        "size": {
         "fixed": 14,
         "min": 8,
         "max": 20
        },
        "color": {
         "field": "Value",
         "fixed": "dark-green"
        },
        "opacity": 0.9,
        "symbol": {
         "mode": "fixed",
         "fixed": "img/icons/marker/circle.svg"
        }
       },
       "showLegend": true
      },
      "location": {
       "mode": "coords",
       "latitude": "lat",
       "longitude": "lon"
      },
      "tooltip": true
     }
    ]
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {}
    }
   ]
  },
