  {
   "id": 6,
   "type": "timeseries",
   "title": "Verbleibende Zertifikatslaufzeit je Website",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 26
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "(probe_ssl_earliest_cert_expiry{job=~\"website_probes|demo_broken_site\"} - time()) / 86400",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
