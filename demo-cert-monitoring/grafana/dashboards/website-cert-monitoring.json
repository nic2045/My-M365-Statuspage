{
 "title": "Website & Zertifikats-Monitoring (App-Owner)",
 "uid": "website-cert-monitoring",
 "timezone": "browser",
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "schemaVersion": 39,
 "templating": {
  "list": [
   {
    "name": "critical_threshold",
    "type": "textbox",
    "label": "Kritisch (Tage)",
    "current": {
     "text": "7",
     "value": "7"
    },
    "query": "7"
   },
   {
    "name": "warning_threshold",
    "type": "textbox",
    "label": "Warnung (Tage)",
    "current": {
     "text": "30",
     "value": "30"
    },
    "query": "30"
   }
  ]
 },
 "panels": [
  {
   "id": 10,
   "type": "row",
   "title": "Übersicht",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 1,
   "type": "stat",
   "title": "Überwachte Websites",
   "gridPos": {
    "h": 6,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "count(probe_success{job=~\"website_probes|demo_broken_site\"})",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 11,
   "type": "stat",
   "title": "Nicht erreichbar",
   "gridPos": {
    "h": 6,
    "w": 4,
    "x": 4,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "probe_success = 0 - Website antwortet nicht oder TLS-Handshake schlägt fehl.",
   "targets": [
    {
     "expr": "sum(probe_success{job=~\"website_probes|demo_broken_site\"} < bool 1)",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 12,
   "type": "stat",
   "title": "Zertifikate abgelaufen",
   "gridPos": {
    "h": 6,
    "w": 4,
    "x": 8,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(((probe_ssl_earliest_cert_expiry{job=~\"website_probes|demo_broken_site\"} - time()) / 86400) < bool 0)",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 13,
   "type": "stat",
   "title": "Läuft ab in < $critical_threshold Tagen",
   "gridPos": {
    "h": 6,
    "w": 4,
    "x": 12,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(((( probe_ssl_earliest_cert_expiry{job=~\"website_probes|demo_broken_site\"} - time()) / 86400) >= bool 0) * (((probe_ssl_earliest_cert_expiry{job=~\"website_probes|demo_broken_site\"} - time()) / 86400) < bool $critical_threshold))",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 14,
   "type": "stat",
   "title": "Läuft ab in < $warning_threshold Tagen",
   "gridPos": {
    "h": 6,
    "w": 4,
    "x": 16,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum((((probe_ssl_earliest_cert_expiry{job=~\"website_probes|demo_broken_site\"} - time()) / 86400) >= bool $critical_threshold) * (((probe_ssl_earliest_cert_expiry{job=~\"website_probes|demo_broken_site\"} - time()) / 86400) < bool $warning_threshold))",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Kürzeste verbleibende Zertifikatslaufzeit (Tage)",
   "gridPos": {
    "h": 6,
    "w": 4,
    "x": 20,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "min((probe_ssl_earliest_cert_expiry{job=~\"website_probes|demo_broken_site\"} - time()) / 86400)",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "d",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 3
       },
       {
        "color": "yellow",
        "value": 14
       },
       {
        "color": "green",
        "value": 30
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 20,
   "type": "row",
   "title": "Details je Website",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 7
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 4,
   "type": "table",
   "title": "Status je Website",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "probe_success{job=~\"website_probes|demo_broken_site\"}",
     "instant": true,
     "format": "table",
     "refId": "A"
    },
    {
     "expr": "(probe_ssl_earliest_cert_expiry{job=~\"website_probes|demo_broken_site\"} - time()) / 86400",
     "instant": true,
     "format": "table",
     "refId": "B"
    },
    {
     "expr": "probe_duration_seconds{job=~\"website_probes|demo_broken_site\"}",
     "instant": true,
     "format": "table",
     "refId": "C"
    }
   ],
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {}
    },
    {
     "id": "joinByField",
     "options": {
      "byField": "instance",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Time 3": true,
       "__name__": true,
       "__name__ 1": true,
       "__name__ 2": true,
       "__name__ 3": true,
       "job": true,
       "job 1": true,
       "job 2": true,
       "job 3": true,
       "demo_fixture": true,
       "demo_fixture 1": true,
       "demo_fixture 2": true,
       "demo_fixture 3": true
      },
      "renameByName": {
       "instance": "Website"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "A"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Erreichbar (1=ja/0=nein)"
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "green",
           "value": 1
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "B"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Zertifikat läuft ab in (Tage)"
       },
       {
        "id": "unit",
        "value": "d"
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "orange",
           "value": 3
          },
          {
           "color": "yellow",
           "value": 14
          },
          {
           "color": "green",
           "value": 30
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "C"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Antwortzeit (s)"
       }
      ]
     }
    ]
   }
  },
  {
   "id": 30,
   "type": "row",
   "title": "Analyse",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 16
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 15,
   "type": "table",
   "title": "Top Zertifikatsaussteller",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 17
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "topk(10, sort_desc(count by (issuer) (probe_ssl_last_chain_info{job=~\"website_probes|demo_broken_site\"})))",
     "instant": true,
     "format": "table",
     "refId": "A"
    }
   ],
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {}
    },
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true
      },
      "renameByName": {
       "issuer": "Aussteller",
       "Value": "Anzahl Zertifikate"
      }
     }
    }
   ]
  },
  {
   "id": 16,
   "type": "table",
   "title": "Kürzeste Restlaufzeit",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 17
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "(probe_ssl_earliest_cert_expiry{job=~\"website_probes|demo_broken_site\"} - time()) / 86400",
     "instant": true,
     "format": "table",
     "refId": "A"
    }
   ],
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {}
    },
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "demo_fixture": true
      },
      "renameByName": {
       "instance": "Website",
       "Value": "Tage bis Ablauf"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "fields": {},
      "sort": [
       {
        "field": "Tage bis Ablauf",
        "desc": false
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Tage bis Ablauf"
      },
      "properties": [
       {
        "id": "unit",
        "value": "d"
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "orange",
           "value": 3
          },
          {
           "color": "yellow",
           "value": 14
          },
          {
           "color": "green",
           "value": 30
          }
         ]
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 40,
   "type": "row",
   "title": "Verlauf",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 25
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Antwortzeit je Website",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 26
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "probe_duration_seconds{job=~\"website_probes|demo_broken_site\"}",
