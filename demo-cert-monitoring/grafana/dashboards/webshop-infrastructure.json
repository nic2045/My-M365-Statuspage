      },
      "targets": [
        {
          "expr": "shop_service_memory_percent{service=\"frontend\"}",
          "legendFormat": "Frontend",
          "refId": "A"
        },
        {
          "expr": "shop_service_memory_percent{service=\"checkout\"}",
