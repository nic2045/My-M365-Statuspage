    {
      "id": 9,
      "type": "timeseries",
      "title": "Netzwerk – Checkout-Service (in/out)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "shop_service_network_mbps{service=\"checkout\",direction=\"in\"}",
          "legendFormat": "In",
          "refId": "A"
        },
        {
          "expr": "shop_service_network_mbps{service=\"checkout\",direction=\"out\"}",
