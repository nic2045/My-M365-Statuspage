{
 "title": "Avaya Call Center – Betriebsansicht (Callcenter-Optimierung)",
 "uid": "avaya-callcenter-operations",
 "description": "Fokussierte Betriebssicht für Callcenter-Manager - inspiriert vom klassischen Avaya/BCMS-Operator-Layout (https://blog.upinget.com/2021/02/07/using-grafana-to-monitor-avaya-call-center/): Warteschlangen-KPIs, Trunk-Status, Agenten-Auslastung. Ergänzt die breitere Customer-Care-Dashboard oben um die Kennzahlen, an denen ein Callcenter-Manager tatsächlich Personal-/SLA-Entscheidungen festmacht.",
 "timezone": "browser",
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "KPIs",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Anrufe in Warteschlange",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cc_avaya_calls_queued",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 15
       },
       {
        "color": "red",
        "value": 30
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Ältester wartender Anruf",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 6,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cc_avaya_oldest_call_waiting_seconds",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 90
       },
       {
        "color": "red",
        "value": 180
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Service Level",
   "description": "Anteil der Anrufe, die innerhalb der SLA-Zielzeit angenommen wurden (branchenüblich 80/20).",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 12,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cc_avaya_service_level_percent",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 65
       },
       {
        "color": "green",
        "value": 80
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "ACHT (Ø Bearbeitungszeit)",
   "description": "Average Call Handling Time: Gesprächszeit + Nachbearbeitung.",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 18,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cc_avaya_acht_seconds",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 360
       },
       {
        "color": "red",
        "value": 420
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 10,
   "type": "row",
   "title": "Trunk & Warteschlange",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 7
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 11,
   "type": "barchart",
   "title": "SIP-Trunk-Mitglieder nach Status",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cc_avaya_trunk_members",
     "instant": true,
     "format": "table",
     "refId": "A"
    }
   ],
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {}
    },
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true
      },
      "renameByName": {
       "status": "Status",
       "cc_avaya_trunk_members": "Anzahl"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "orientation": "vertical",
    "xTickLabelRotation": 0,
    "showValue": "always",
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": false
    },
    "tooltip": {
     "mode": "single"
    }
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Warteschlange & Wartezeit (Verlauf)",
   "gridPos": {
    "h": 8,
    "w": 16,
    "x": 8,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cc_avaya_calls_queued",
     "legendFormat": "Anrufe in Warteschlange",
     "refId": "A"
    },
    {
     "expr": "cc_avaya_avg_wait_seconds",
     "legendFormat": "Ø Wartezeit (s)",
     "refId": "B"
    },
    {
     "expr": "cc_avaya_oldest_call_waiting_seconds",
     "legendFormat": "Ältester wartender Anruf (s)",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineInterpolation": "smooth"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 20,
   "type": "row",
   "title": "Agenten",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 16
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 21,
   "type": "barchart",
   "title": "Agenten-Status je Standort",
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 17
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "cc_avaya_agents_available",
     "instant": true,
     "format": "table",
     "refId": "A"
    },
    {
     "expr": "cc_avaya_agents_busy",
     "instant": true,
     "format": "table",
     "refId": "B"
    },
    {
     "expr": "cc_avaya_agents_not_ready",
     "instant": true,
     "format": "table",
     "refId": "C"
    }
   ],
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {}
    },
    {
     "id": "merge",
     "options": {},
     "filter": {
      "id": "byRefId",
      "options": "A"
     }
    },
    {
     "id": "merge",
     "options": {},
     "filter": {
      "id": "byRefId",
      "options": "B"
     }
    },
    {
     "id": "merge",
     "options": {},
     "filter": {
      "id": "byRefId",
      "options": "C"
     }
    },
    {
     "id": "joinByField",
     "options": {
      "byField": "site",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Time 2": true,
       "Time 3": true,
       "__name__": true,
       "__name__ 2": true,
       "__name__ 3": true,
       "instance": true,
       "instance 2": true,
       "instance 3": true,
       "job": true,
       "job 2": true,
       "job 3": true
      },
      "renameByName": {
       "site": "Standort"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "axisLabel": "Agenten"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "A"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Verfügbar"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "B"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Im Gespräch"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "C"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "Nachbearbeitung/Pause"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "orientation": "vertical",
    "xTickLabelRotation": 0,
    "showValue": "auto",
    "stacking": "normal",
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  }
 ]
}
