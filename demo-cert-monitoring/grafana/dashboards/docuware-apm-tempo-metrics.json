{
 "title": "DocuWare APM – Tempo-Metriken (App-Owner)",
 "uid": "docuware-apm-tempo-metrics",
 "description": "Aggregierte Metriken, die Tempos Metrics-Generator aus den DocuWare-Beispiel-Traces (docuware_apm_tempo_trace.py / break-docuware-apm.sh) ableitet - Request-Rate, Latenz-Perzentile und Fehlerquote je Span (span-metrics) sowie Traffic zwischen Services (service-graphs). Braucht tempo/tempo.yaml's metrics_generator + Prometheus mit --web.enable-remote-write-receiver (siehe docker-compose.yml). Ohne gesendete Traces bleiben alle Panels leer - erst ./break-docuware-apm.sh laufen lassen.",
 "timezone": "browser",
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Übersicht",
   "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Request-Rate (docuware-*)",
   "description": "Calls/s über alle DocuWare-Spans (traces_spanmetrics_calls_total)",
   "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
   "datasource": { "type": "prometheus", "uid": "prometheus" },
   "targets": [
    {
     "expr": "sum(rate(traces_spanmetrics_calls_total{service=~\"docuware.*\"}[5m]))",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": { "calcs": ["lastNotNull"] },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "decimals": 2
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Fehlerquote (docuware-*)",
   "description": "Anteil Spans mit STATUS_CODE_ERROR an allen Calls",
   "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 },
   "datasource": { "type": "prometheus", "uid": "prometheus" },
   "targets": [
    {
     "expr": "100 * sum(rate(traces_spanmetrics_calls_total{service=~\"docuware.*\", status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum(rate(traces_spanmetrics_calls_total{service=~\"docuware.*\"}[5m]))",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": { "calcs": ["lastNotNull"] },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "orange", "value": 5 },
       { "color": "red", "value": 20 }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "p95-Latenz (docuware-*)",
   "description": "95. Perzentil über traces_spanmetrics_latency (Histogramm)",
   "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
   "datasource": { "type": "prometheus", "uid": "prometheus" },
   "targets": [
    {
     "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=~\"docuware.*\"}[5m])))",
     "instant": true,
     "refId": "A"
    }
   ],
   "options": {
    "reduceOptions": { "calcs": ["lastNotNull"] },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "orange", "value": 500 },
       { "color": "red", "value": 1500 }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "row",
   "title": "Verlauf je Service (span-metrics)",
   "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Request-Rate je Service",
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
   "datasource": { "type": "prometheus", "uid": "prometheus" },
   "targets": [
    {
     "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"docuware.*\"}[1m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": { "unit": "reqps" },
    "overrides": []
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "p95-Latenz je Service",
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
   "datasource": { "type": "prometheus", "uid": "prometheus" },
   "targets": [
    {
     "expr": "1000 * histogram_quantile(0.95, sum by (service, le) (rate(traces_spanmetrics_latency_bucket{service=~\"docuware.*\"}[1m])))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": { "unit": "ms" },
    "overrides": []
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Fehlerhafte Calls je Service",
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
   "datasource": { "type": "prometheus", "uid": "prometheus" },
   "targets": [
    {
     "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"docuware.*\", status_code=\"STATUS_CODE_ERROR\"}[1m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "color": { "mode": "fixed", "fixedColor": "red" }
    },
    "overrides": []
   }
  },
  {
   "id": 20,
   "type": "row",
   "title": "Service-Graph (Abhängigkeiten zwischen Services)",
   "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 21,
   "type": "timeseries",
   "title": "Requests zwischen Services (client → server)",
   "description": "Aus Parent-/Child-Spans abgeleitete Abhängigkeitskanten (traces_service_graph_request_total)",
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
   "datasource": { "type": "prometheus", "uid": "prometheus" },
   "targets": [
    {
     "expr": "sum by (client, server) (rate(traces_service_graph_request_total{server=~\"docuware.*\"}[1m]))",
     "legendFormat": "{{client}} → {{server}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": { "unit": "reqps" },
    "overrides": []
   }
  },
  {
   "id": 22,
   "type": "timeseries",
   "title": "Fehlgeschlagene Requests zwischen Services",
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
   "datasource": { "type": "prometheus", "uid": "prometheus" },
   "targets": [
    {
     "expr": "sum by (client, server) (rate(traces_service_graph_request_failed_total{server=~\"docuware.*\"}[1m]))",
     "legendFormat": "{{client}} → {{server}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "color": { "mode": "fixed", "fixedColor": "red" }
    },
    "overrides": []
   }
  }
 ]
}
