# Azure / Entra ID – App Registration in Azure Portal
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-app-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_REDIRECT_URI=https://statuspage.example.com/auth/callback

# Optional: separate, more privileged credentials (Application.ReadWrite.All)
# ONLY for secret rotation via OpenBao (see below) – the app itself needs
# only ServiceHealth.Read.All day-to-day. Leave empty = use AZURE_* above
# for rotation too (only useful if the app registration deliberately grants
# both permissions).
AZURE_MGMT_TENANT_ID=
AZURE_MGMT_CLIENT_ID=
AZURE_MGMT_CLIENT_SECRET=

# OpenBao – optional backing store for AZURE_CLIENT_SECRET (instead of/in addition to .env).
# Reachable only over VPN; see app/azure_secret_manager.py and the
# "Load / rotate from OpenBao" button in Admin → Settings → Azure AD App.
OPENBAO_ADDR=https://secrets-prod.pyur.com
OPENBAO_SECRET_PATH=secret/data/m365-statuspage/azure-client-secret
OPENBAO_TOKEN=
OPENBAO_RENEWAL_THRESHOLD_DAYS=30
OPENBAO_NEW_SECRET_LIFETIME_DAYS=180

# GitHub – ONLY for submitting OpenBao access requests via the in-app page
# "/openbao-request" (alternative to GitHub Issue form for requesters without
# a GitHub account). Fine-grained PAT with "Issues: Read and write" ONLY on
# the repo below. Leave empty = page shows an info message instead of auto-filing.
# Intentionally not named "GITHUB_TOKEN" – some environments (CI runners,
# dev sandboxes) set a generic GITHUB_TOKEN variable by default, which would
# be unintentionally picked up otherwise.
OPENBAO_REQUEST_GITHUB_TOKEN=
OPENBAO_REQUEST_GITHUB_REPO=nic2045/My-M365-Statuspage

# Security – session key.
# Leave empty: auto-generates a 32-byte hex string on first startup and
# persists it to data/secret_key (survives restarts).
# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Embed widget API key (leave empty = OIDC required for /embed)
EMBED_API_KEY=

# Admin authorization – primarily via Entra ID app role.
# Setup in Azure Portal:
#   1. App Registration → "App roles" → Create role (e.g.,
#      Display name "Admin", Value "Admin", Allowed member types "Users/Groups").
#   2. Enterprise Applications → "Users and groups" → Assign user or
#      security group to the "Admin" role.
# The token carries the role in the `roles` claim. ADMIN_ROLE = required value.
ADMIN_ROLE=Admin

# Optional additional allowlist (OR-combined with the role):
# comma-separated email addresses/UPNs. Leave empty if using app roles only.
# If both allowlist and `roles` claim are empty = every authenticated tenant
# user is admin (legacy behavior; logged on startup).
# Example: ADMIN_EMAILS=admin@example.com,it-team@example.com
ADMIN_EMAILS=

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/statuspage.db

# Monitored services (comma-separated; must match Graph API service names exactly)
MONITORED_SERVICES=Exchange Online,SharePoint Online,Microsoft Teams

# Poll interval in minutes
POLL_INTERVAL_MINUTES=10

# Application
DEBUG=false
APP_TITLE=M365 Dienststatus

# DeepL API (optional) – translates Microsoft's English service health text
# (incident titles, impact descriptions, message-center posts) into the configured
# language (DEFAULT_LANGUAGE / Admin → Settings). Leave empty = texts remain
# English as supplied by Microsoft. Free-tier keys end in ":fx" and are
# auto-routed to the free API endpoint.
DEEPL_API_KEY=
DEEPL_API_URL=

# Development: disable OIDC authentication (NEVER in production!)
# All routes become accessible without login; logged-in user = "Dev User"
DISABLE_AUTH=false
